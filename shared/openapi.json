          "content": {
            "type": "string",
            "maxLength": 100000,
            "minLength": 1,
            "title": "Content"
          },
          "format": {
            "type": "string",
            "enum": [
              "markdown",
              "text",
              "json"
            ],
            "title": "Format",
            "default": "text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
