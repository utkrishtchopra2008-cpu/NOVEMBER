          },
          "notes": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Notes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "lifecycle",
          "notes"
        ],
        "title": "LifecycleInput"
      },
      "Packet": {
        "properties": {
          "finding": {
            "$ref": "#/components/schemas/Finding"
          },
          "related_reports": {
            "items": {
              "$ref": "#/components/schemas/Correlation"
            },
            "type": "array",
            "title": "Related Reports"
          },
          "markdown": {
            "type": "string",
            "title": "Markdown"
          },
          "warning": {
            "type": "string",
            "title": "Warning",
            "default": "Source-reference verification does not prove exploitability."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "finding",
          "related_reports",
          "markdown"
        ],
        "title": "Packet"
      },
      "Reference": {
        "properties": {
          "file_path": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "File Path"
          },
          "function_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Function Name"
          },
          "start_line": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 1000000.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Line"
          },
          "end_line": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 1000000.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "End Line"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Reference"
      },
      "Report": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
