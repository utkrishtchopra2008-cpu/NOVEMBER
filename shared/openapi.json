  "components": {
    "schemas": {
      "Analysis": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "mode": {
            "type": "string",
            "enum": [
              "demo",
              "live"
            ],
            "title": "Mode"
          },
          "status": {
            "type": "string",
            "const": "completed",
            "title": "Status",
            "default": "completed"
          },
          "findings": {
            "items": {
              "$ref": "#/components/schemas/Finding"
            },
            "type": "array",
            "title": "Findings"
          },
          "correlations": {
            "items": {
              "$ref": "#/components/schemas/Correlation"
            },
            "type": "array",
            "title": "Correlations"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "mode"
        ],
        "title": "Analysis"
      },
      "Claim": {
        "properties": {
          "original_excerpt": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Original Excerpt"
          },
          "assertion": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Assertion"
          },
          "component": {
            "type": "string",
            "maxLength": 200,
            "title": "Component",
            "default": "Unspecified"
          },
          "reference": {
            "$ref": "#/components/schemas/Reference"
          },
          "assumptions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Assumptions"
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "verification_status": {
            "type": "string",
            "enum": [
              "Verified reference",
              "Inconsistent reference",
              "Requires manual investigation"
            ],
            "title": "Verification Status"
          },
          "verification_reason": {
            "type": "string",
            "title": "Verification Reason"
          },
          "snippet": {
            "items": {
              "$ref": "#/components/schemas/CodeLine"
            },
            "type": "array",
            "title": "Snippet"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "original_excerpt",
          "assertion",
          "verification_status",
          "verification_reason"
        ],
        "title": "Claim"
      },
      "CodeLine": {
        "properties": {
          "number": {
            "type": "integer",
            "title": "Number"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "kind": {
            "type": "string",
            "enum": [
              "context",
              "added",
              "removed"
            ],
            "title": "Kind",
            "default": "context"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "number",
          "text"
        ],
        "title": "CodeLine"
      },
      "Correlation": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "finding_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Finding Ids"
          },
          "shared_files": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Shared Files"
          },
          "shared_functions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Shared Functions"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Reasons"
          },
          "decision": {
            "type": "string",
            "enum": [
              "PENDING",
              "CONFIRMED_DUPLICATE",
              "KEPT_SEPARATE"
            ],
            "title": "Decision",
            "default": "PENDING"
          },
          "decided_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Decided At"
          },
          "reviewer_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reviewer Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "finding_ids",
          "shared_files",
          "shared_functions",
          "reasons"
        ],
        "title": "Correlation"
      },
      "CorrelationDecision": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "CONFIRMED_DUPLICATE",
              "KEPT_SEPARATE"
            ],
            "title": "Decision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "decision"
        ],
        "title": "CorrelationDecision"
      },
      "Finding": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "analysis_id": {
            "type": "string",
            "title": "Analysis Id"
          },
          "repo_url": {
            "type": "string",
            "title": "Repo Url"
          },
          "commit_sha": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{40}$",
            "title": "Commit Sha"
          },
          "report": {
            "$ref": "#/components/schemas/Report"
          },
          "claims": {
            "items": {
              "$ref": "#/components/schemas/Claim"
            },
            "type": "array",
            "title": "Claims"
          },
          "lifecycle": {
            "type": "string",
            "enum": [
              "New",
              "Investigating",
              "Validated",
              "Resolved"
            ],
            "title": "Lifecycle",
            "default": "New"
          },
          "severity": {
            "type": "string",
            "enum": [
              "Unassessed",
              "Low",
              "Medium",
              "High",
              "Critical"
            ],
            "title": "Severity",
            "default": "Unassessed"
          },
          "business_impact": {
            "type": "string",
            "title": "Business Impact",
            "default": "Requires reviewer assessment"
          },
          "reviews": {
            "items": {
              "$ref": "#/components/schemas/Review"
            },
            "type": "array",
            "title": "Reviews"
          },
          "missing_evidence": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Missing Evidence"
          },
          "investigation_steps": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Investigation Steps"
          },
          "extraction_metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Extraction Metadata"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "analysis_id",
          "repo_url",
          "commit_sha",
          "report",
          "claims"
        ],
        "title": "Finding"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ImpactInput": {
        "properties": {
          "analysis_id": {
            "type": "string",
            "title": "Analysis Id"
          },
          "pr_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pr Url"
          },
          "pr_number": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Pr Number"
          },
          "new_commit_sha": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "New Commit Sha"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "analysis_id"
        ],
        "title": "ImpactInput"
      },
      "ImpactItem": {
        "properties": {
          "finding_id": {
            "type": "string",
            "title": "Finding Id"
          },
          "claim_id": {
            "type": "string",
            "title": "Claim Id"
          },
          "file_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Path"
          },
          "flag": {
            "type": "string",
            "enum": [
              "RETEST_REQUIRED",
              "NO_REFERENCE_CHANGE",
              "MANUAL_MAPPING_REQUIRED"
            ],
            "title": "Flag"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "original": {
            "items": {
              "$ref": "#/components/schemas/CodeLine"
            },
            "type": "array",
            "title": "Original"
          },
          "current": {
            "items": {
              "$ref": "#/components/schemas/CodeLine"
            },
            "type": "array",
            "title": "Current"
          },
          "diff": {
            "type": "string",
            "title": "Diff"
          },
          "current_verification_status": {
            "type": "string",
            "enum": [
              "Verified reference",
              "Inconsistent reference",
              "Requires manual investigation"
            ],
            "title": "Current Verification Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "finding_id",
          "claim_id",
          "file_path",
          "flag",
          "reason",
          "original",
          "current",
          "diff",
          "current_verification_status"
        ],
        "title": "ImpactItem"
      },
      "ImpactResult": {
        "properties": {
          "analysis_id": {
            "type": "string",
            "title": "Analysis Id"
          },
          "original_commit_sha": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{40}$",
            "title": "Original Commit Sha"
          },
          "current_commit_sha": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{40}$",
            "title": "Current Commit Sha"
          },
          "changed_files": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Changed Files"
          },
          "changed_files_scope": {
            "type": "string",
            "const": "referenced_files",
            "title": "Changed Files Scope",
            "default": "referenced_files"
          },
          "impacts": {
            "items": {
              "$ref": "#/components/schemas/ImpactItem"
            },
            "type": "array",
            "title": "Impacts"
          },
          "warning": {
            "type": "string",
            "title": "Warning",
            "default": "Code changes require retesting; no finding has been resolved automatically."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "analysis_id",
          "original_commit_sha",
          "current_commit_sha",
          "changed_files",
          "impacts"
        ],
        "title": "ImpactResult"
      },
      "Intake": {
        "properties": {
          "repo_url": {
            "type": "string",
            "title": "Repo Url"
          },
          "commit_sha": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{40}$",
            "title": "Commit Sha"
          },
          "reports": {
            "items": {
              "$ref": "#/components/schemas/Report"
            },
            "type": "array",
            "maxItems": 3,
            "minItems": 1,
            "title": "Reports"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "repo_url",
          "commit_sha",
          "reports"
        ],
        "title": "Intake"
      },
      "LifecycleInput": {
        "properties": {
          "lifecycle": {
            "type": "string",
            "enum": [
              "New",
