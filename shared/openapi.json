          },
          "notes": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Notes"
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "reviewer_id": {
            "type": "string",
            "title": "Reviewer Id"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "decision",
          "notes",
          "reviewer_id"
        ],
        "title": "Review"
      },
      "ReviewInput": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "APPROVED",
              "REJECTED",
              "MORE_EVIDENCE"
            ],
            "title": "Decision"
          },
          "notes": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Notes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "decision",
          "notes"
        ],
        "title": "ReviewInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
