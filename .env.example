# Leave empty to use the interactive local fixture mode.
# Set the API origin to FastAPI (never expose demo mode publicly).
VITE_API_BASE_URL=

# Required only when the configured FastAPI reports MODE=live.
# Browser-safe values for the SAME Supabase project used by FastAPI.
# Never use a service_role or secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
